# Copy to tests/.env.test (git-ignored) and fill in. Enter the service-role key ONLY here
# in the terminal/editor — never in chat, code, or a committed file.
#
# Find these in Supabase: Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional overrides
# SANDBOX_ORGS=5
# SANDBOX_PROJECTS=3
# SANDBOX_PASSWORD=Sandbox!Test-2026
